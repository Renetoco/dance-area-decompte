# Copiez ce fichier en .env (local) ou renseignez ces variables dans les
# réglages du projet Vercel (Settings > Environment Variables) pour la prod.
# Voir DEPLOIEMENT.md pour le détail de chaque valeur.

# Base de données Postgres (Neon, Vercel Postgres, ou autre)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Chaîne aléatoire d'au moins 32 caractères, pour signer les cookies de session.
# Générez-en une avec : openssl rand -base64 32
SESSION_SECRET="change-me-generate-a-real-random-secret"

# Secret partagé avec le service de cron externe pour protéger /api/cron/daily
CRON_SECRET="change-me-generate-a-real-random-secret"

# URL publique de l'app une fois déployée (utilisée dans les emails et le QR code)
APP_URL="https://votre-app.vercel.app"

# SMTP Infomaniak
SMTP_HOST="mail.infomaniak.com"
SMTP_PORT="587"
SMTP_USER="rene.torres@dancearea.ch"
SMTP_PASSWORD="le-mot-de-passe-de-cette-boite-mail"
MAIL_FROM="Dance Area — Décomptes <rene.torres@dancearea.ch>"

# Premier compte admin, créé automatiquement par le script de seed s'il n'en
# existe aucun encore.
ADMIN_EMAIL="rene.torres@dancearea.ch"
ADMIN_INITIAL_PASSWORD="change-me-un-mot-de-passe-fort"
